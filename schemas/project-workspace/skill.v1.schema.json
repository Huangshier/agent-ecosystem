{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-ecosystem/skill/v1",
  "title": "Agent Ecosystem Project Skill v1",
  "description": "A public-safe project-local Agent Skill produced from a canonical internal Procedure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "title",
    "description",
    "status",
    "updated",
    "summary",
    "keywords",
    "kind",
    "exposure",
    "triggers",
    "side_effects"
  ],
  "properties": {
    "schema": {
      "const": "agent-ecosystem/skill/v1",
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "updated": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-](?:[0-1][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "command",
        "workflow"
      ]
    },
    "exposure": {
      "const": "internal",
      "type": "string"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
