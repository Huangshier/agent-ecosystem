{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-ecosystem/glossary/v1",
  "title": "Agent Ecosystem Glossary v1",
  "type": "object",
  "required": ["schema", "terms"],
  "properties": {
    "schema": {
      "const": "agent-ecosystem/glossary/v1",
      "type": "string"
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["canonical", "aliases", "symbols", "evidence"],
        "properties": {
          "canonical": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
