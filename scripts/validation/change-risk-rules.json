{
  "schema_version": 2,
  "unknown_tier": 3,
  "empty_tier": 3,
  "base_check_modules": ["documentation"],
  "fallback_suites": ["agent-skill-bridge", "bootstrap-safety", "hooks-runtime", "installer-contract", "knowledge-contracts", "project-context-gate", "repository-guards", "runtime-smoke", "template-consistency", "workspace-assets"],
  "suite_hosts": {
    "knowledge-contracts": ["ubuntu-latest"],
    "bootstrap-safety": ["windows-latest"],
    "agent-skill-bridge": ["windows-latest"],
    "hooks-runtime": ["windows-latest", "ubuntu-latest", "macos-latest"],
    "installer-contract": ["windows-latest"],
    "runtime-smoke": ["windows-latest"],
    "project-context-gate": ["windows-latest", "ubuntu-latest", "macos-latest"],
    "template-consistency": ["windows-latest"],
    "repository-guards": ["ubuntu-latest"],
    "release-checkpoint": ["ubuntu-latest"],
    "workspace-assets": ["windows-latest", "ubuntu-latest", "macos-latest"]
  },
  "self_protection_hosts": ["windows-latest"],
  "module_suites": {
    "knowledge": ["knowledge-contracts"],
    "bootstrap": ["bootstrap-safety"],
    "bridge": ["agent-skill-bridge"],
    "hooks": ["hooks-runtime"],
    "installer": ["installer-contract", "runtime-smoke"],
    "runtime": ["installer-contract", "runtime-smoke"],
    "context-gate": ["project-context-gate"],
    "templates": ["bootstrap-safety", "template-consistency"],
    "repository": ["repository-guards"],
    "release": ["release-checkpoint"],
    "workspace-schema": ["workspace-assets"],
    "workspace": ["workspace-assets"],
    "continuity": ["workspace-assets"],
    "migration": ["workspace-assets"],
    "validation-routing": []
  },
  "rules": [
    { "id": "validation-routing", "tier": 3, "pattern": "^(scripts/(validate-(change|targeted-change)|invoke-local-validation)\\.ps1|scripts/test-(validate-change|heavy-targeted-regression|local-validation-plan|powershell-runtime-requirement|required-validation-gate|release-sharding|validation-evidence-contract|exact-candidate-contract|lineage-verifier)\\.ps1|scripts/validation/(change-risk-rules\\.json|change-risk-fixtures/|pr-[s]ecret-keyword-scan\\.ps1$|sensitive-scan-contract\\.ps1$|test-sensitive-scan\\.ps1$|local-validation-plan-contract\\.ps1$|powershell-runtime-requirement\\.ps1$|powershell-runtime-requirement-fixtures/|release-classifier-output-contract\\.ps1$|release-classifier-output-fixtures/|release-shard-contract\\.(json|ps1)$|release-test-helper\\.ps1$|required-validation-gate\\.ps1$|required-validation-gate-fixtures/|write-evidence-manifest\\.ps1$|resolve-pull-request-candidate\\.ps1$|finalize-candidate-evidence\\.ps1$|lineage-verifier\\.ps1$|git-stable-patch-id\\.ps1$|lineage-verifier-fixtures/)|\\.github/(scripts/resolve-validation-check-bindings\\.js|workflows/release-validation\\.yml)$)", "modules": ["validation-routing"], "control_plane": true },
    { "id": "project-workspace-schema", "tier": 2, "pattern": "^schemas/project-workspace/", "modules": ["workspace-schema"], "control_plane": false },
    { "id": "project-workspace-template", "tier": 2, "pattern": "^templates/project/assets/", "modules": ["workspace"], "control_plane": false },
    { "id": "project-workspace-continuity-reserved", "tier": 2, "pattern": "^skills/project-workspace/scripts/project-continuity\\.ps1$", "modules": ["continuity"], "control_plane": false },
    { "id": "project-workspace-migration-reserved", "tier": 2, "pattern": "^scripts/migrate-project\\.ps1$", "modules": ["migration"], "control_plane": false },
    { "id": "project-workspace-parser", "tier": 2, "pattern": "^skills/project-workspace/scripts/read-project-assets\\.ps1$", "modules": ["workspace"], "control_plane": false },
    { "id": "project-workspace-validation", "tier": 2, "pattern": "^(scripts/test-project-workspace-parser\\.ps1$|scripts/validation/project-workspace-parser-checks\\.ps1$|scripts/validation/project-workspace-fixtures/)", "modules": ["workspace"], "control_plane": false },
    { "id": "workflow-control-plane", "tier": 3, "pattern": "^\\.github/workflows/", "modules": ["release"], "control_plane": true },
    { "id": "release-validator-control-plane", "tier": 3, "pattern": "^scripts/validate-release\\.ps1$", "modules": ["release"], "control_plane": true },
    { "id": "release-and-cross-module-contract", "tier": 3, "pattern": "^(CHANGELOG\\.md$|VERSION$|docs/releases/|docs/release-(process|readiness)\\.md$|profiles/|schemas?/|scripts/validation/release-(body-contract|documentation-checks|eval-benchmark-generator|eval-iteration-checks|eval-report-generator|eval-runner-generator|memory-diagnostics-fixture-checks|parser-safety-checks)\\.ps1$|scripts/validation/release-body-contract-fixtures/)", "modules": ["release"] },
    { "id": "validation-leaf-bridge", "tier": 2, "pattern": "^scripts/validation/release-agent-skill-bridge-checks\\.ps1$", "modules": ["bridge"] },
    { "id": "validation-leaf-bootstrap", "tier": 2, "pattern": "^scripts/validation/release-bootstrap-checks\\.ps1$", "modules": ["bootstrap", "installer", "runtime"] },
    { "id": "validation-leaf-hooks", "tier": 2, "pattern": "^scripts/validation/release-claude-hooks-guardrails-checks\\.ps1$", "modules": ["hooks"] },
    { "id": "validation-leaf-installer-runtime", "tier": 2, "pattern": "^scripts/validation/release-(hub-initialization|installer-contract|runtime-smoke|runtime-status)-checks\\.ps1$", "modules": ["installer", "runtime"] },
    { "id": "validation-leaf-knowledge", "tier": 1, "pattern": "^scripts/validation/release-knowledge-(candidate|hub|search)-checks\\.ps1$", "modules": ["knowledge"] },
    { "id": "validation-leaf-templates", "tier": 2, "pattern": "^scripts/validation/release-(project-template|template-language)-checks\\.ps1$", "modules": ["bootstrap", "templates"] },
    { "id": "validation-leaf-repository", "tier": 1, "pattern": "^scripts/validation/release-(governance-workflow|repository)-checks\\.ps1$", "modules": ["repository"] },
    { "id": "agent-skill-bridge", "tier": 2, "pattern": "^scripts/link-agent-skills\\.ps1$", "modules": ["bridge"] },
    { "id": "installer-runtime", "tier": 2, "pattern": "^scripts/(install|uninstall)\\.ps1$", "modules": ["installer", "runtime"] },
    { "id": "hooks", "tier": 2, "pattern": "(^|/)\\.claude/|hooks?", "modules": ["hooks"] },
    { "id": "bundled-bootstrap-template", "tier": 2, "pattern": "^skills/project-bootstrap/assets/knowledge-hub-template/templates/", "modules": ["bootstrap", "templates"] },
    { "id": "bootstrap-knowledge-helper", "tier": 2, "pattern": "^skills/project-bootstrap/scripts/(manage_candidates|promote_experience|rebuild_experience_index|search_experience)\\.ps1$", "modules": ["bootstrap", "knowledge"] },
    { "id": "project-bootstrap", "tier": 2, "pattern": "^skills/project-bootstrap/", "modules": ["bootstrap"] },
    { "id": "project-context-gate", "tier": 2, "pattern": "^skills/project-context-gate/", "modules": ["context-gate"] },
    { "id": "unsupported-runtime-skill", "tier": 3, "pattern": "^skills/", "modules": ["unsupported-runtime-skill"] },
    { "id": "knowledge-runtime-helper", "tier": 2, "pattern": "^knowledge-hub/scripts/(manage_candidates|promote_experience|rebuild_experience_index|search_experience)\\.ps1$", "modules": ["bootstrap", "knowledge"] },
    { "id": "unmapped-knowledge-runtime", "tier": 3, "pattern": "^knowledge-hub/scripts/", "modules": ["unsupported-knowledge-runtime"] },
    { "id": "templates-bootstrap", "tier": 2, "pattern": "^(knowledge-hub/templates/|scripts/validation/project-bootstrap-|templates?/)", "modules": ["templates", "bootstrap"] },
    { "id": "knowledge", "tier": 1, "pattern": "^knowledge-hub/knowledge/", "modules": ["knowledge"] },
    { "id": "project-context-gate-validation", "tier": 2, "pattern": "^scripts/validation/project-context-gate-(checks\\.ps1|fixtures/)", "modules": ["context-gate"] },
    { "id": "unmapped-local-fixtures", "tier": 3, "pattern": "^scripts/validation/.+fixtures/", "modules": ["unsupported-fixture"] },
    { "id": "repository-guard-tests", "tier": 1, "pattern": "^(scripts/test-(pr-identity-guard|issue-triage-decision-command)\\.ps1|\\.github/scripts/(pr-identity-guard|issue-triage-decision-command)\\.js)$", "modules": ["repository"] },
    { "id": "unmapped-tests", "tier": 3, "pattern": "^(scripts/test-|\\.github/scripts/)", "modules": ["unsupported-test"] },
    { "id": "metadata-and-docs", "tier": 0, "pattern": "^(README(\\.[^/]+)?\\.md$|scripts/README\\.md$|LICENSE|NOTICE|CONTRIBUTING\\.md$|docs/|\\.github/(ISSUE_TEMPLATE/|pull_request_template\\.md$)|\\.(editorconfig|gitattributes|gitignore)$)", "modules": ["documentation"] }
  ]
}
