{
  "schema_version": 1,
  "unknown_tier": 3,
  "empty_tier": 3,
  "tiers": {
    "0": {
      "required_checks": ["change-classification", "diff-check", "document-and-data-parse", "public-safe-scan", "base-guard", "identity-guard"],
      "skipped_checks": ["quick-repository-checks", "targeted-module-matrix", "full-release-matrix"],
      "hosted_plan": { "validation_jobs": ["classify", "quick-validation"], "full_validator_calls": 0, "targeted_os_jobs": 0 }
    },
    "1": {
      "required_checks": ["change-classification", "diff-check", "document-and-data-parse", "public-safe-scan", "quick-repository-checks", "base-guard", "identity-guard"],
      "skipped_checks": ["targeted-module-matrix", "full-release-matrix"],
      "hosted_plan": { "validation_jobs": ["classify", "quick-validation"], "full_validator_calls": 0, "targeted_os_jobs": 0 }
    },
    "2": {
      "required_checks": ["change-classification", "diff-check", "document-and-data-parse", "public-safe-scan", "quick-repository-checks", "targeted-module-matrix", "base-guard", "identity-guard"],
      "skipped_checks": ["full-release-matrix"],
      "hosted_plan": { "validation_jobs": ["classify", "targeted-validation"], "full_validator_calls": 0, "targeted_os_jobs": 3 }
    },
    "3": {
      "required_checks": ["change-classification", "base-guard", "identity-guard", "full-release-matrix"],
      "skipped_checks": [],
      "hosted_plan": { "validation_jobs": ["classify", "validate", "validate-windows-powershell"], "full_validator_calls": 4, "targeted_os_jobs": 0 }
    }
  },
  "rules": [
    { "id": "validation-routing", "tier": 3, "pattern": "^(scripts/validate-(change|targeted-change)\\.ps1|scripts/test-validate-change\\.ps1|scripts/validation/change-risk-rules\\.json|scripts/validation/change-risk-fixtures/|\\.github/workflows/release-validation\\.yml$)", "modules": ["validation-routing"] },
    { "id": "release-and-cross-module-contract", "tier": 3, "pattern": "^(CHANGELOG\\.md$|VERSION$|docs/releases/|docs/release-(process|readiness)\\.md$|profiles/|schemas?/|scripts/validate-release\\.ps1$|scripts/validation/release-|\\.github/workflows/)", "modules": ["release"] },
    { "id": "installer-runtime", "tier": 2, "pattern": "^scripts/(install|uninstall|link-agent-skills)\\.ps1$", "modules": ["installer", "runtime"] },
    { "id": "hooks", "tier": 2, "pattern": "(^|/)\\.claude/|hooks?", "modules": ["hooks"] },
    { "id": "skills", "tier": 2, "pattern": "^skills/", "modules": ["skills"] },
    { "id": "templates-bootstrap", "tier": 2, "pattern": "^(knowledge-hub/templates/|knowledge-hub/scripts/|scripts/validation/project-bootstrap-|templates?/)", "modules": ["templates", "bootstrap"] },
    { "id": "knowledge", "tier": 1, "pattern": "^knowledge-hub/knowledge/", "modules": ["knowledge"] },
    { "id": "local-fixtures", "tier": 1, "pattern": "^scripts/validation/.+fixtures/", "modules": ["fixtures"] },
    { "id": "non-runtime-tests", "tier": 1, "pattern": "^(scripts/test-|\\.github/scripts/)", "modules": ["repository"] },
    { "id": "metadata-and-docs", "tier": 0, "pattern": "^(README(\\.[^/]+)?\\.md$|scripts/README\\.md$|LICENSE|NOTICE|CONTRIBUTING\\.md$|docs/|\\.github/(ISSUE_TEMPLATE/|pull_request_template\\.md$)|\\.(editorconfig|gitattributes|gitignore)$)", "modules": ["documentation"] }
  ]
}
